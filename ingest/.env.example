# ============================================================
#  Variables du robot d'import Notion (ingest/)
#
#  En local : copie ce fichier sous le nom  .env  (dans ce
#  même dossier ingest/), puis remplis les valeurs.
#  DATABASE_URL n'est pas nécessaire ici : le robot lit
#  automatiquement web/.env.local.
#
#  En CI (GitHub Actions) : ces mêmes valeurs se remplissent
#  dans  repo → Settings → Secrets and variables → Actions,
#  chacune comme "New repository secret" (mêmes noms).
# ============================================================

# --- Notion (OBLIGATOIRE) -----------------------------------
# 1. Crée l'intégration : notion.so/my-integrations
#    → copie le "Internal Integration Secret" (ntn_...)
# 2. Connecte la page Notion qui contient la base à cette
#    intégration : menu ⋯ de la page → Connections
NOTION_TOKEN=

# L'identifiant de la base de données Notion : la suite de
# 32 lettres/chiffres dans l'URL de la base (avant le "?").
NOTION_DATABASE_ID=

# --- Stockage R2 Cloudflare (optionnel) ---------------------
# Sans ces valeurs, le robot écrit les médias en local dans
# web/public/media (mode développement). En CI elles sont
# OBLIGATOIRES (secrets GitHub).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
