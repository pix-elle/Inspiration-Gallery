# ============================================================
#  Variables d'environnement du site (Next.js)
#
#  En local : copie ce fichier sous le nom  .env.local
#  (dans ce même dossier web/), puis remplis les valeurs.
#  Le fichier .env.local est ignoré par git — il ne sera
#  jamais publié, c'est normal et voulu.
#
#  En production (Vercel) : ces mêmes variables se remplissent
#  dans  Project → Settings → Environment Variables.
# ============================================================

# --- Base de données Neon (OBLIGATOIRE) ---------------------
# Où la trouver : console.neon.tech → ton projet → bouton
# "Connect" → copie la "Connection string".
DATABASE_URL=

# --- Resend : newsletter (optionnel) ------------------------
# Tant que ces deux valeurs sont vides, les inscriptions sont
# quand même enregistrées en base — elles ne sont simplement
# pas recopiées dans Resend.
# API key : resend.com → API Keys → Create API key (re_...)
# Audience : resend.com → Audiences → Create audience → copier son ID
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ============================================================
#  Back-office (/admin)
# ============================================================

# Signe les cookies de session. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Le changer déconnecte immédiatement tout le monde — c'est le bouton
# « déconnecter tous les appareils » du projet.
AUTH_SECRET=

# Qui a le droit d'entrer, séparées par des virgules. Une adresse absente
# de cette liste peut demander un lien autant qu'elle veut : elle n'en
# recevra jamais. Retirer une adresse déconnecte la personne aussitôt.
ADMIN_EMAILS=

# Expéditeur des liens de connexion. Tant que le domaine n'est pas vérifié
# chez Resend, laisser onboarding@resend.dev — Resend ne délivrera alors
# qu'à l'adresse propriétaire du compte. Une fois mail.nexus-studio.ch
# vérifié, passer à noreply@mail.nexus-studio.ch.
AUTH_EMAIL_FROM=onboarding@resend.dev

# --- Stockage R2 -------------------------------------------
# Mêmes valeurs que ingest/.env : le back-office en a besoin pour signer
# les envois du navigateur vers Cloudflare. Le site public, lui, n'a
# besoin de rien ici — il ne lit que des URLs déjà écrites en base.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Jeton GitHub à portée fine (permission Actions: read & write, dépôt
# Inspiration-Gallery uniquement). Sert à réveiller le runner qui encode
# les vidéos. Sans lui, un envoi reste bloqué au statut « processing ».
GITHUB_DISPATCH_TOKEN=
